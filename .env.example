# Frontend
VITE_PROCESSING_API_URL=http://127.0.0.1:8000

# Backend
FINSIM_ACCOUNT_DB=processing_api/data/finsim_local.db

# Comma separated list of exact frontend origins allowed to call the API.
# For production, replace this with your deployed frontend URL.
FINSIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email delivery
# Keep local while developing. The API returns verification codes in responses.
FINSIM_EMAIL_MODE=local

# Use SMTP in deployment so account verification, sign in codes, and deletion
# confirmation codes are sent by email instead of displayed in the browser.
# FINSIM_EMAIL_MODE=smtp
# FINSIM_SMTP_HOST=smtp.example.com
# FINSIM_SMTP_PORT=587
# FINSIM_SMTP_USERNAME=your-smtp-username
# FINSIM_SMTP_PASSWORD=your-smtp-password
# FINSIM_EMAIL_FROM=FinSim <no-reply@your-domain.com>
# FINSIM_SMTP_USE_TLS=true
